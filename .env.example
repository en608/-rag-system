# PostgreSQL 配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db
DB_PASSWORD=postgres
DB_PORT=5433

# 数据库连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# HuggingFace 镜像（国内用户可配置）
# HF_ENDPOINT=https://hf-mirror.com

# LLM API 配置（以小米 MiMo 为例）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
OPENAI_LLM_MODEL=mimo-v2.5-pro

# Embedding 模型（本地模型，无需 API）
# 使用 shibing624/text2vec-base-chinese，768 维

# Rerank 模型配置
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=32

# 异步推理配置
RERANK_ASYNC_ENABLED=true
RERANK_QUEUE_SIZE=100
RERANK_WORKERS=2

# 应用配置
APP_NAME=RAG System V1.0
APP_PORT=8080
DEBUG=false

# JWT 认证密钥（生产环境请修改为随机密钥）
SECRET_KEY=your-secret-key-change-in-production

# 文本切分参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 向量检索 Top-K
RETRIEVAL_TOP_K=5

# 向量维度（本地 text2vec-base-chinese 输出 768 维）
EMBEDDING_DIMENSION=768

# API 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_CHAT=20/minute

# CORS 配置（生产环境请设置具体的允许域名）
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# 安全配置（生产环境请设置具体的允许主机）
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Nginx 配置
NGINX_PORT=80
NGINX_SSL_PORT=443
